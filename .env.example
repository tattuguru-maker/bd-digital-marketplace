# Convex (backend + auth + file storage)
#
# Generated automatically by `npx convex dev` the first time you run it.
# Both values are written to .env.local — copy them here only if you need a
# checked-in template for teammates.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_DEPLOY_KEY=

# Public site URL (used for email links, OAuth callbacks, OG tags etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
